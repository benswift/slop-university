---
import { orientations, signagePlaylist, type Orientation } from "../../lib/signage";

// Chromeless, fullscreen e-signage player. Built for kiosk browsers: any number
// of panels, each pointed at the route matching its mounting
// (/signage/landscape or /signage/portrait), with no site chrome and no theme
// layout. It shows one poster an hour, letterboxed on black, and plays a video
// between posters, crossfading in over the old poster and out onto the new
// one. Posters are generated at the panels' native 16:9 / 9:16 aspect, so
// current ones fill the screen edge-to-edge; older A3-era posters keep their
// letterbox. The actual PDF page is rendered to a canvas at device resolution
// via PDF.js, so the vector text stays crisp at any display size.
//
// The page never reloads to change what it shows, because a reload is never
// seamless. Ahead of each change it fetches the playlist again
// (/signage/<orientation>.json, rebuilt with every deploy), renders the next
// poster into a spare canvas and downloads the whole video into memory, so a
// network blip can stall neither. Anything not ready at the change is skipped:
// no video means a straight crossfade between posters, and no poster means the
// current one stays. The page reloads itself once a day, to pick up changes
// to this player.
//
// A panel that is physically portrait but whose framebuffer is landscape (a
// landscape-native screen mounted on its side, with no OS-level rotation) can
// use /signage/portrait/?rotate=cw (or ?rotate=ccw): it serves the same portrait
// posters but rotates the stage 90 degrees in CSS so the poster stands upright
// once the panel's physical rotation is accounted for. The stage's layout box is
// swapped to the panel's true (portrait) dimensions before rotating, so the
// letterbox maths and the PDF render resolution stay correct. Flip cw/ccw to
// match the way the panel was turned --- read client-side, so no rebuild needed.
//
// `?every=<seconds>` shortens the hour, for testing a panel.
export function getStaticPaths() {
  return orientations.map((orientation) => ({ params: { orientation } }));
}

const orientation = Astro.params.orientation as Orientation;
const playlist = await signagePlaylist(orientation);

// A usable first frame for browsers with JavaScript disabled or still loading.
const initial = playlist.research[0] ?? playlist.marketing[0];
const title = initial?.title ?? "Slop University";

// The poster's aspect ratio, known at build time from the thumbnail. Drives the
// CSS box so the poster scales up to fill a large panel, not just down to fit a
// small one --- `max-width`/`max-height` alone would cap it and never enlarge.
const posterAspect = initial ? initial.width / initial.height : 1;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} --- Slop University signage</title>
    <style>
      :root {
        color-scheme: dark;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        background: #000;
        overflow: hidden;
      }

      /* Kiosk: no cursor, no text selection, no touch callouts. */
      body {
        cursor: none;
        user-select: none;
        -webkit-user-select: none;
      }

      #stage {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 100vw;
        height: 100vh;
      }

      /* The two poster canvases and the fallback image share the one grid cell
         and fit the viewport preserving the poster's aspect ratio, which each
         carries as its own --poster-aspect.

         Size the box from the aspect ratio rather than `max-width`/`max-height`:
         those cap a large intrinsic size down to the viewport but never scale a
         small one up, so a 5200px canvas buffer would sit letterboxed at 68%
         width on a 7680px 8K panel. Taking the smaller of the width- and
         height-bound fit reproduces `object-fit: contain`, but as the element's
         real box, so the shadow still hugs the poster's edge. */
      .poster,
      #fallback {
        grid-area: 1 / 1;
        aspect-ratio: var(--poster-aspect);
        width: min(100vw, calc(100vh * var(--poster-aspect)));
        height: auto;
        object-fit: contain;
      }

      .poster,
      #video {
        opacity: 0;
        transition: opacity 1.2s ease-in-out;
      }

      .poster.shown,
      #video.shown {
        opacity: 1;
      }

      #fallback[hidden] {
        display: none;
      }

      /* The video lies over the posters, filling the stage. */
      #video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #000;
      }

      /* Physically-portrait panel with a landscape framebuffer (see the head
         comment). `?rotate=cw|ccw` swaps the stage's layout box to the panel's
         true portrait dimensions (width <- 100vh, height <- 100vw) then spins it
         90deg. Because clientWidth/clientHeight report the pre-transform box, the
         canvas still renders at the panel's real resolution; the transform is
         purely how it lands on the glass. */
      body.rotate #stage {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100vh;
        height: 100vw;
        transform: translate(-50%, -50%) rotate(var(--rotate, 90deg));
      }

      /* Same contain-fit as the un-rotated poster, but measured against the
         rotated stage (vw/vh swapped) rather than the raw viewport. */
      body.rotate .poster,
      body.rotate #fallback {
        width: min(100vh, calc(100vw * var(--poster-aspect)));
      }
    </style>
  </head>
  <body>
    <main
      id="stage"
      aria-label={`Poster: ${title}`}
      data-playlist={JSON.stringify(playlist)}
      data-orientation={orientation}
      style={`--poster-aspect: ${posterAspect}`}
    >
      <canvas class="poster"></canvas>
      <canvas class="poster"></canvas>
      {
        initial && (
          <img
            id="fallback"
            src={initial.thumb}
            alt={`Poster: ${title}`}
            width={initial.width}
            height={initial.height}
          />
        )
      }
      <video id="video" playsinline preload="auto"></video>
    </main>

    <script>
      // A bundled module script (no `define:vars`, which would force a
      // non-module inline script and leave these bare imports unresolved at
      // runtime). Build-time config rides in on `#stage` data attributes.
      //
      // Use pdf.js's *legacy* build: it transpiles + polyfills for older
      // engines (both main thread and worker). The Raspberry Pi signage kiosk
      // ran Chromium 136, which lacks Map.prototype.getOrInsertComputed (V8
      // ~13.9 / Chrome ~137); the default build calls it during render and
      // throws, silently falling back to the thumbnail. The legacy build ships
      // its own polyfill, so the poster actually renders there.
      import * as pdfjs from "pdfjs-dist/legacy/build/pdf.mjs";
      import workerUrl from "pdfjs-dist/legacy/build/pdf.worker.min.mjs?url";
      import type { Playlist, Poster, Video } from "../../lib/signage";

      pdfjs.GlobalWorkerOptions.workerSrc = workerUrl;

      const stage = document.getElementById("stage")!;
      const orientation = stage.dataset.orientation;
      const canvases = [...document.querySelectorAll<HTMLCanvasElement>(".poster")];
      const fallback = document.getElementById("fallback") as HTMLImageElement | null;
      const video = document.getElementById("video") as HTMLVideoElement;
      const params = new URLSearchParams(location.search);

      // One slot per hour (or per `?every=` seconds); each change is prepared
      // this far ahead of it.
      const SLOT_MS = (Number(params.get("every")) || 3600) * 1000;
      const PREPARE_MS = Math.min(5 * 60 * 1000, SLOT_MS / 2);
      // The first poster that wouldn't load retries on this much shorter
      // cycle. A cold boot on wifi can drop a large asset mid-flight --- the
      // clock steps on first NTP sync, tailscaled reads the jump as a wake and
      // rebinds the link, and anything still streaming dies. Waiting a full
      // hour to recover from a blip is the wrong trade for an unattended sign.
      const RETRY_MS = 60 * 1000;
      const FADE_MS = 1200;
      // The daily reload, at the first change after this local hour.
      const RELOAD_HOUR = 4;
      // Chromium's max canvas dimension. Exceeding it yields a blank canvas.
      const MAX_CANVAS_PX = 8192;

      // A physically-portrait panel with a landscape framebuffer asks for
      // rotation via `?rotate=cw|ccw`. Toggle the CSS mode up front, before the
      // first render, so fitScale measures the rotated (portrait) stage box.
      const rotate = params.get("rotate");
      if (rotate === "cw" || rotate === "ccw") {
        document.body.classList.add("rotate");
        document.body.style.setProperty("--rotate", rotate === "ccw" ? "-90deg" : "90deg");
      }

      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const slotAt = (t: number) => Math.floor(t / SLOT_MS);

      // Exponential backoff, capped: a boot-time blip clears in seconds, but a
      // genuinely unreachable origin shouldn't be hammered.
      const backoff = (attempt: number) => Math.min(30_000, 500 * 2 ** attempt);

      async function withRetry<T>(fn: () => Promise<T>, attempts = 4): Promise<T> {
        let last: unknown;
        for (let n = 0; n < attempts; n++) {
          try {
            return await fn();
          } catch (err) {
            last = err;
            await sleep(backoff(n));
          }
        }
        throw last;
      }

      // Give the two physical orientations different positions in the same
      // five-slot cadence. Research occupies four slots; an ad gets the fifth.
      // If an orientation has no candidate of the requested type, use the
      // other type rather than leaving a blank screen.
      function posterFor(list: Playlist, slot: number): Poster | undefined {
        const offset = orientation === "portrait" ? 2 : 0;
        const wantsMarketing = (slot + offset) % 5 === 4;
        const preferred = wantsMarketing ? list.marketing : list.research;
        const pool = preferred.length ? preferred : wantsMarketing ? list.research : list.marketing;
        return pool.length ? pool[(slot + offset) % pool.length] : undefined;
      }

      const videoFor = (list: Playlist, slot: number): Video | undefined =>
        list.videos.length ? list.videos[slot % list.videos.length] : undefined;

      // Render at exactly the device pixels the poster will occupy: the CSS box
      // is the viewport-fitted rectangle, so multiplying by the device pixel
      // ratio gives a 1:1 buffer. Crisp on a 1080p test monitor and on a native
      // 8K panel alike, without a fixed target resolution that is simultaneously
      // wasteful on the former and too small on the latter.
      function fitScale(base: { width: number; height: number }) {
        const dpr = window.devicePixelRatio || 1;
        const box = Math.min(
          (stage.clientWidth || window.innerWidth) / base.width,
          (stage.clientHeight || window.innerHeight) / base.height,
        );
        return Math.min(box * dpr, MAX_CANVAS_PX / base.width, MAX_CANVAS_PX / base.height);
      }

      async function draw(el: HTMLCanvasElement, page: any) {
        const base = page.getViewport({ scale: 1 });
        const vp = page.getViewport({ scale: fitScale(base) });
        el.width = Math.round(vp.width);
        el.height = Math.round(vp.height);
        await page.render({ canvas: el, viewport: vp }).promise;
        // Pin the box to the page's true ratio (the thumbnail's can differ by
        // a rounding step).
        el.style.setProperty("--poster-aspect", String(vp.width / vp.height));
      }

      type Shown = { canvas: HTMLCanvasElement; page: any; doc: any; poster: Poster };
      let current: Shown | undefined;

      // Render a poster into whichever canvas isn't showing.
      async function prepare(poster: Poster): Promise<Shown> {
        const canvas = canvases.find((c) => c !== current?.canvas)!;
        return withRetry(async () => {
          const doc = pdfjs.getDocument({ url: poster.pdf });
          try {
            const page = await (await doc.promise).getPage(1);
            await draw(canvas, page);
            return { canvas, page, doc, poster };
          } catch (err) {
            void doc.destroy();
            throw err;
          }
        });
      }

      function show(next: Shown) {
        const old = current;
        next.canvas.classList.add("shown");
        old?.canvas.classList.remove("shown");
        current = next;
        stage.setAttribute("aria-label", `Poster: ${next.poster.title}`);
        document.title = `${next.poster.title} --- Slop University signage`;
        if (fallback) setTimeout(() => (fallback.hidden = true), FADE_MS);
        if (old) setTimeout(() => void old.doc.destroy(), FADE_MS);
      }

      // The whole video, in memory: once this resolves, playback can't stall
      // on the network.
      async function load(v: Video): Promise<string> {
        const blob = await withRetry(async () => {
          const r = await fetch(v.src);
          if (!r.ok) throw new Error(`${v.src}: HTTP ${r.status}`);
          return r.blob();
        });
        const url = URL.createObjectURL(blob);
        video.src = url;
        await new Promise<void>((resolve, reject) => {
          video.oncanplaythrough = () => resolve();
          video.onerror = () => reject(video.error);
        });
        return url;
      }

      // Fade the video in over the poster, swap the poster underneath it, and
      // fade it out at its end onto the new one.
      async function play(url: string, next: Shown | undefined) {
        video.currentTime = 0;
        // Videos play with their sound (a screen that should be quiet is
        // muted at the display). A browser that won't start sound without a
        // gesture --- a kiosk launched without
        // --autoplay-policy=no-user-gesture-required --- plays it muted.
        await video.play().catch(async (err: unknown) => {
          if ((err as Error)?.name !== "NotAllowedError") throw err;
          video.muted = true;
          await video.play();
        });
        video.classList.add("shown");
        await sleep(FADE_MS);
        if (next) show(next);
        await new Promise<void>((resolve) => {
          video.onended = () => resolve();
          video.onerror = () => resolve();
        });
        video.classList.remove("shown");
        await sleep(FADE_MS);
        video.removeAttribute("src");
        video.load();
        URL.revokeObjectURL(url);
      }

      async function fetchPlaylist(fallbackList: Playlist): Promise<Playlist> {
        try {
          const r = await fetch(`/signage/${orientation}.json`, { cache: "no-store" });
          if (r.ok) return (await r.json()) as Playlist;
        } catch (err) {
          console.error("signage: playlist fetch failed, keeping the last one", err);
        }
        return fallbackList;
      }

      let playlist = JSON.parse(stage.dataset.playlist ?? '{"research":[],"marketing":[],"videos":[]}') as Playlist;
      const startedOn = new Date().toDateString();

      // Prepare the change at the start of `slot`, wait for it, then make it.
      async function change(slot: number) {
        const at = slot * SLOT_MS;
        await sleep(Math.max(0, at - PREPARE_MS - Date.now()));

        // The once-a-day reload happens in place of a change, early in the
        // morning, so the player itself stays current.
        const now = new Date(at);
        if (now.toDateString() !== startedOn && now.getHours() >= RELOAD_HOUR) {
          await sleep(Math.max(0, at - Date.now()));
          location.reload();
          return;
        }

        playlist = await fetchPlaylist(playlist);
        const poster = posterFor(playlist, slot);
        const clip = videoFor(playlist, slot);
        const [next, url] = await Promise.all([
          poster ? prepare(poster).catch((err) => console.error("signage: poster not ready", err)) : undefined,
          clip ? load(clip).catch((err) => console.error("signage: video not ready", err)) : undefined,
        ]);

        await sleep(Math.max(0, at - Date.now()));
        if (url) await play(url, next ?? undefined).catch((err) => console.error("signage: video failed", err));
        else if (next) show(next);
      }

      async function run() {
        const first = posterFor(playlist, slotAt(Date.now()));
        if (!first) return; // only a rebuild can fill an empty orientation
        if (fallback) {
          fallback.src = first.thumb;
          fallback.alt = `Poster: ${first.title}`;
          fallback.width = first.width;
          fallback.height = first.height;
          fallback.style.setProperty("--poster-aspect", String(first.width / first.height));
        }
        try {
          show(await prepare(first));
        } catch (err) {
          // Leave the fallback thumbnail on screen; log for the kiosk console.
          console.error("signage: PDF render failed, showing thumbnail fallback", err);
          setTimeout(() => location.reload(), RETRY_MS);
          return;
        }

        // The panel can change mode under us --- a fresh EDID on hotplug, or a
        // compositor scale change. Re-render at the new device resolution
        // rather than letting the browser rescale a stale buffer.
        let debounce: ReturnType<typeof setTimeout>;
        window.addEventListener("resize", () => {
          clearTimeout(debounce);
          debounce = setTimeout(() => current && void draw(current.canvas, current.page).catch(() => {}), 250);
        });

        for (let slot = slotAt(Date.now()) + 1; ; slot = Math.max(slot + 1, slotAt(Date.now()) + 1)) {
          await change(slot);
        }
      }

      void run();
    </script>
  </body>
</html>
