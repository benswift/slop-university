---
import { getCollection, getEntry, render } from "astro:content";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import PageVideo from "../components/PageVideo.astro";
import { siteConfig } from "../site-config";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
// A page can open with a video from the videos collection: `video: <id>`.
const video = entry.data.video ? await getEntry("videos", entry.data.video) : undefined;
if (entry.data.video && !video) throw new Error(`${entry.id}: no video "${entry.data.video}"`);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  heroImage={entry.data.heroImage}
  {...siteConfig}
  socialImage={entry.data.heroImage}
>
  {video && <PageVideo video={video.data} />}
  <Content />
</ContentLayout>
