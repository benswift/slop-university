---
import type { CollectionEntry } from "astro:content";
import { videoUrl } from "../lib/videos";

// A video at the top of a page. With both cuts, the portrait one plays on a
// narrow screen and the landscape one otherwise: two players, one shown by a
// media query; neither preloads, so the hidden one never downloads anything.
// A video made in one orientation plays that cut at every width.
interface Props {
  video: CollectionEntry<"videos">["data"];
}

const { video } = Astro.props;
const cuts = (["landscape", "portrait"] as const).flatMap((cut) => {
  const encode = video.web?.[cut];
  return encode ? [{ cut, ...encode }] : [];
});
---

{
  cuts.length > 0 && (
    <figure class:list={["page-video", { both: cuts.length > 1 }]}>
      {cuts.map(({ cut, video: file, cover }) => (
        <video
          class={cut}
          src={videoUrl(file)}
          poster={videoUrl(cover)}
          controls
          playsinline
          preload="none"
          width={cut === "landscape" ? 1920 : 1080}
          height={cut === "landscape" ? 1080 : 1920}
          aria-label={video.title}
        />
      ))}
    </figure>
  )
}

<style>
  .page-video {
    margin: 0 0 2rem;
  }

  .page-video video {
    display: block;
    width: 100%;
    height: auto;
    background: #1a1a1a;
  }

  .page-video .portrait {
    max-height: 85vh;
    width: auto;
    max-width: 100%;
    margin-inline: auto;
  }

  .page-video.both .portrait {
    display: none;
  }

  @media (max-width: 40rem) {
    .page-video.both .landscape {
      display: none;
    }

    .page-video.both .portrait {
      display: block;
    }
  }
</style>
