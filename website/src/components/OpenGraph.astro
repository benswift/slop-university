---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { siteConfig } from "../site-config";
import type { OgCard } from "../lib/images";

// Per-page OpenGraph and Twitter card meta, injected through the layouts'
// named head slot. Deliberately no citation_* (Highwire) meta: robots.txt
// disallows /outputs/pdf/ to keep fabricated citations out of scholarly
// indexers, and scholarly head meta would work against that.
interface Props {
  title: string;
  description?: string;
  /** og:type; use "article" for outputs and news, "profile" for people. */
  type?: "website" | "article" | "profile";
  /** A local image (encoded to a JPEG card at build time) or a pre-encoded
   *  remote card from src/lib/images.ts ogImage(). */
  image?: ImageMetadata | OgCard;
  imageAlt?: string;
}

const { title, description, type = "website", image, imageAlt } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Card scrapers largely don't decode AVIF; serve the card as JPEG. For local
// images, encode here at quality 70 rather than the default 80: these are
// one-per-page 1200px cards only ever seen scaled down in a social embed.
// Remote cards arrive pre-encoded to the same recipe (ops/encode-images.py)
// and pass straight through.
const card = !image
  ? undefined
  : "url" in image
    ? { href: image.url, width: image.width, height: image.height }
    : await getImage({ src: image, width: 1200, format: "jpeg", quality: 70 }).then((r) => ({
        href: new URL(r.src, Astro.site).href,
        width: r.attributes.width as number,
        height: r.attributes.height as number,
      }));
---

<link rel="canonical" href={canonical.href} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={siteConfig.name} />
{card && <meta property="og:image" content={card.href} />}
{card && <meta property="og:image:width" content={String(card.width)} />}
{card && <meta property="og:image:height" content={String(card.height)} />}
{card && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content={card ? "summary_large_image" : "summary"} />
