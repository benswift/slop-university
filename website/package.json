{
  "name": "slop-university-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "lint": "oxlint && pnpm lint:css",
    "lint:fix": "oxlint --fix && pnpm lint:css:fix",
    "lint:css": "stylelint --allow-empty-input \"src/**/*.css\"",
    "lint:css:fix": "stylelint --allow-empty-input --fix \"src/**/*.css\"",
    "format:content": "oxfmt src/content/news src/content/outputs src/content/pages src/content/grants",
    "format:check:content": "oxfmt --check src/content/news src/content/outputs src/content/pages src/content/grants",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/iconoir": "^1.2.12",
    "astro": "^7.4.0",
    "astro-theme-slop": "github:benswift/astro-theme-slop#v0.3.0",
    "astro-theme-university": "git+https://github.com/ANUcybernetics/astro-theme-university.git#v0.22.0",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@e18e/eslint-plugin": "^0.8.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "pagefind": "^1.5.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vega": "^6.4.0",
    "vega-lite": "^6.5.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
