# Claude Code working directory --- ignore everything except committed slash commands
.claude/*
!.claude/commands/

# typst compile cache
.typst-cache/

# logfiles from cron runs
logs/

# the working-tree handoffs from the /publish agent to the cron wrapper: the
# staged social post (data/pending-post.json) and the tick's PDFs
# (data/pending-uploads/) --- never committed.
#
# No trailing slash: in the press worktree data is a SYMLINK to the main
# checkout's data/, and `data/` (directories only) would leave it untracked.
# LEADING slash, though: unanchored `data` matches a directory of that name at
# ANY depth, which silently swallowed a run of mislanded PDFs under
# website/data/pending-uploads/ --- invisible to git status, untouched by
# `git clean -fd`, and so undiagnosable from the repo. Anchored, a stray data/
# anywhere but the root shows up and gets cleaned.
/data

# generated outputs are kept locally only, not committed (everything under
# output/ --- .typ, .bib, images, charts, pdf, overviews)
output/

# impeccable tool cache (regenerated by a hook; not part of the project)
.impeccable/

# python bytecode
__pycache__/

# local-only ANU-themed preset snapshot (never public, never published)
private/

# local-only agent instructions (documents the private capability)
CLAUDE.local.md

# excluded from the public repo cut (files stay in the local tree and the
# private archive): ANU media-library photos (photographer-credited, not
# redistributable) and planning files that describe private capabilities
references/*.avif
backlog/
docs/

# NOTE: website/public/outputs/ is deliberately NOT ignored. Output PDFs are
# served from the bucket at pdf.slop.university and must never be committed, but
# the push wrapper's allowlist already rejects that path, so ignoring it would
# add no protection --- and would cost the visibility that matters: a PDF
# mislanded there needs to show up in git status and be swept by `git clean -fd`,
# not sit there silently while the tick fails somewhere downstream.
