[Unit]
Description=Trigger publish generator slot %i

[Timer]
# Hourly. A run takes ten minutes or so, well inside the period, so each slot
# produces at most one candidate an hour; the period is the throughput lever. A
# tick that fires while the previous run is still going never starts a second
# one beside it: the slot lock in ops/publish-generate.sh makes it skip.
OnCalendar=hourly
# Spread the slots so they do not all hit the model, Replicate and the disk in
# the same second.
RandomizedDelaySec=2min
# Deliberately NOT Persistent=true. A catch-up burst of missed generator ticks
# would fire several slots at once after a reboot and queue candidates nobody
# asked for; the next scheduled tick is soon enough.
Unit=slop-publish-gen@%i.service

[Install]
WantedBy=timers.target
