[Unit]
Description=Trigger publish generator slot %i

[Timer]
# Rest twenty minutes after each run ends, then start the next. A run takes
# about twenty minutes, so a slot produces one candidate every forty or so ---
# half the back-to-back rate a calendar period shorter than a run gives.
# Lengthen the rest to meter throughput further; enabling another slot doubles it.
OnUnitInactiveSec=20min
# OnUnitInactiveSec never fires for a unit that has not run since the timer
# started, so this kicks the first run after a start or a reboot.
OnActiveSec=2min
# Spread the slots so they do not all hit the model, Replicate and the disk in
# the same second.
RandomizedDelaySec=2min
# Deliberately NOT Persistent=true (it only applies to OnCalendar anyway). A
# catch-up burst would fire several slots at once after a reboot.
Unit=slop-publish-gen@%i.service

[Install]
WantedBy=timers.target
