#!/usr/bin/env zsh
set -euo pipefail

readonly REPO_ROOT="${0:A:h:h}"
readonly AGENT_RUN="${AGENT_RUN_BIN:-agent-run}"

profile="${AGENT_PROFILE:-claude-sub}"
model="${AGENT_MODEL:-}"
deadline=""

usage() {
  cat <<'EOF'
Usage: slopu [--profile NAME] [--model MODEL] [--deadline TIME] <command> [arguments]

Commands:
  from-preset <preset> [steering]  Generate a document from a named preset
  from-source <source>             Typeset a source faithfully
  publish                          Run the autonomous publication workflow
  thesis                           Write a doctoral thesis (hours; opus by default)

Profiles come from ~/.config/agent-run/profiles.toml. The default is
claude-sub; use --profile codex-sub, deepseek, or openrouter to switch routes.
--deadline (thesis only) is a local time the run must have committed by, e.g.
"01:40 tomorrow"; the run paces itself against it.
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --profile)
      (( $# >= 2 )) || { print -u2 "slopu: --profile needs a value"; exit 2; }
      profile="$2"
      shift 2
      ;;
    --model)
      (( $# >= 2 )) || { print -u2 "slopu: --model needs a value"; exit 2; }
      model="$2"
      shift 2
      ;;
    --deadline)
      (( $# >= 2 )) || { print -u2 "slopu: --deadline needs a value"; exit 2; }
      deadline="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      print -u2 "slopu: unknown option: $1"
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

(( $# > 0 )) || { usage >&2; exit 2; }
command="$1"
shift

agent_args=(
  --profile "$profile"
  --cwd "$REPO_ROOT"
  --claude-dangerously-skip-permissions
  --codex-sandbox danger-full-access
)

case "$command" in
  from-preset)
    (( $# > 0 )) || { print -u2 "slopu: from-preset needs a preset"; exit 2; }
    agent_args+=(--claude-effort max)
    prompt="Read skills/from-preset/SKILL.md and execute its workflow end-to-end. Argument: $* (first whitespace-separated word is the preset name; the rest is the steering prompt)."
    ;;
  from-source)
    (( $# > 0 )) || { print -u2 "slopu: from-source needs a source"; exit 2; }
    agent_args+=(--claude-effort max)
    prompt="Read skills/from-source/SKILL.md and execute its workflow end-to-end. Source: $*"
    ;;
  publish)
    (( $# == 0 )) || { print -u2 "slopu: publish takes no arguments"; exit 2; }
    # Preserve the slash command's Sonnet default on its existing Claude
    # subscription route. Alternative profiles keep their own model default.
    if [[ -z "$model" && "$profile" == "claude-sub" ]]; then
      model="sonnet"
    fi
    prompt="Read skills/publish/SKILL.md and execute its workflow end-to-end, non-interactively. No arguments."
    ;;
  thesis)
    (( $# == 0 )) || { print -u2 "slopu: thesis takes no arguments"; exit 2; }
    # The one publish rung with no timer. It is a generator slot, so the
    # candidate it leaves is landed by the lander (ops/publish-land.sh, on its
    # timer when the split is live; run it by hand otherwise). A stronger
    # model and the highest effort by default, because this run exists to
    # spend a budget on one document; --model overrides.
    if [[ -z "$model" && "$profile" == claude-* ]]; then
      model="opus"
    fi
    export SLOPU_AGENT_PROFILE="$profile" SLOPU_AGENT_EFFORT=max
    [[ -z "$model" ]] || export SLOPU_AGENT_MODEL="$model"
    if [[ -n "$deadline" ]]; then
      SLOPU_DEADLINE="$(date -d "$deadline" '+%H:%M on %A %-d %B %Y (%Z)')" || { print -u2 "slopu: cannot parse deadline: $deadline"; exit 2; }
      export SLOPU_DEADLINE
    fi
    export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0
    # The subscription's session window is shared with the generator slots,
    # and a thesis that starts into a half-spent window dies at the session
    # limit an hour in. Rest whichever generator timers are running for the
    # run's duration and start them again on the way out.
    resting=(${(f)"$(systemctl --user list-units --type=timer --state=active --plain --no-legend 'slop-publish-gen@*.timer' | cut -d' ' -f1)"})
    (( ${#resting} == 0 )) || systemctl --user stop "${resting[@]}"
    "$REPO_ROOT/ops/publish-generate.sh" thesis
    status=$?
    (( ${#resting} == 0 )) || systemctl --user start "${resting[@]}"
    exit $status
    ;;
  *)
    print -u2 "slopu: unknown command: $command"
    usage >&2
    exit 2
    ;;
esac

[[ -z "$model" ]] || agent_args+=(--model "$model")
exec "$AGENT_RUN" "${agent_args[@]}" "$prompt"
