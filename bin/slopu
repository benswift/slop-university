#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")"
readonly REPO_ROOT
readonly AGENT_RUN="${AGENT_RUN_BIN:-agent-run}"

profile="${AGENT_PROFILE:-claude-sub}"
model="${AGENT_MODEL:-}"
deadline=""
slot=""
land=0

usage() {
  cat <<'EOF'
Usage: slopu [--profile NAME] [--model MODEL] [--deadline TIME] [--slot N] [--land] <command> [arguments]

Commands:
  from-preset <preset> [steering]  Generate a document from a named preset
  from-source <source>             Typeset a source faithfully
  land <run-id> [--dry-run]        Publish a generated document to the site
  publish                          Run the autonomous publication workflow
  thesis [steering]                Write a doctoral thesis (hours; opus by default)
  video explainer <output-id> [steering]
                                   Make a research explainer video of an output
  video promo [subject] [steering] Make a promo video: a researcher's id,
                                   "university", or anything the steering names
  explainer [output-id]            Make an explainer as a held publish candidate
                                   (rung 2V; the output is drawn when not named)
  held                             List held candidates and their drafts
  approve <run-id>                 Release a held candidate to the lander
  reject <run-id>                  Discard a held candidate, branch and staging

Profiles come from ~/.config/agent-run/profiles.toml. The default is
claude-sub; use --profile codex-sub or openrouter to switch routes.
--deadline (thesis only) is a local time the run must have committed by, e.g.
"01:40 tomorrow"; the run paces itself against it. A thesis takes an optional
steering prompt naming its topic; the setting, school and supervisors are drawn
either way. --slot N (thesis only, N >= 2) runs a further thesis alongside the
first, in its own worktree. Options go before the command.

Hand-steered publishing is two steps. `from-preset --land` writes the site
entry, any news post and the staged assets alongside the PDF; look at the PDF,
then `slopu land <run-id>` gates, uploads and pushes it. `slopu land --list`
shows what is staged, and --dry-run rehearses without sending anything. A video
is the same: `slopu video ...` makes it and stages it; watch the drafts in
video/out/<run-id>/, then `slopu land <run-id>`.

`slopu explainer` runs the same video unattended, in a generator slot of the
publish pipeline: the run reviews itself (video/_kit/review.py) and commits, and
its candidate is held until you watch the drafts `slopu held` lists and run
`slopu approve <run-id>`; the lander then lands it on its next tick.
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --profile)
      (( $# >= 2 )) || { echo "slopu: --profile needs a value" >&2; exit 2; }
      profile="$2"
      shift 2
      ;;
    --model)
      (( $# >= 2 )) || { echo "slopu: --model needs a value" >&2; exit 2; }
      model="$2"
      shift 2
      ;;
    --land)
      land=1
      shift
      ;;
    --slot)
      (( $# >= 2 )) || { echo "slopu: --slot needs a value" >&2; exit 2; }
      slot="$2"
      shift 2
      ;;
    --deadline)
      (( $# >= 2 )) || { echo "slopu: --deadline needs a value" >&2; exit 2; }
      deadline="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "slopu: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      break
      ;;
  esac
done

(( $# > 0 )) || { usage >&2; exit 2; }
command="$1"
shift

if (( land )) && [[ "$command" != from-preset ]]; then
  echo "slopu: --land applies to from-preset only" >&2
  exit 2
fi

agent_args=(
  --profile "$profile"
  --cwd "$REPO_ROOT"
  # The runner-agnostic form. agent-run REJECTS a runner-specific flag on any
  # other runner (exit 2, nothing attempted) rather than ignoring it.
  --bypass-permissions
)

case "$command" in
  from-preset)
    (( $# > 0 )) || { echo "slopu: from-preset needs a preset" >&2; exit 2; }
    if [[ "$profile" == claude-* ]]; then agent_args+=(--claude-effort max); fi
    # Step 9 of the skill --- write the site entry, any news post and the
    # staged assets --- runs only for a run that is meant to be published.
    if (( land )); then export SLOPU_LAND=1; fi
    prompt="Read skills/from-preset/SKILL.md and execute its workflow end-to-end. Argument: $* (first whitespace-separated word is the preset name; the rest is the steering prompt)."
    ;;
  from-source)
    (( $# > 0 )) || { echo "slopu: from-source needs a source" >&2; exit 2; }
    if [[ "$profile" == claude-* ]]; then agent_args+=(--claude-effort max); fi
    prompt="Read skills/from-source/SKILL.md and execute its workflow end-to-end. Source: $*"
    ;;
  video)
    (( $# > 0 )) || { echo "slopu: video needs a kind: explainer or promo" >&2; exit 2; }
    [[ "$1" == explainer || "$1" == promo ]] || { echo "slopu: video kind is explainer or promo" >&2; exit 2; }
    if [[ "$profile" == claude-* ]]; then agent_args+=(--claude-effort max); fi
    prompt="Read skills/video/SKILL.md and execute its workflow end-to-end. Arguments: $* (the first word is the kind; for an explainer the second is the output id; for a promo the second is a researcher id or \"university\" when it is one, and the rest is the steering prompt)."
    ;;
  explainer)
    # Rung 2V, by hand: a generator slot like the thesis's, whose candidate is
    # held for a human to watch (ops/publish-generate.sh says why). opus at max
    # effort by default, with no fallback model.
    if (( $# > 1 )); then echo "slopu: explainer takes at most an output id" >&2; exit 2; fi
    if (( $# == 1 )); then
      [[ -f "$REPO_ROOT/website/src/content/outputs/$1.yml" ]] || { echo "slopu: no output $1" >&2; exit 2; }
      export SLOPU_EXPLAIN="$1"
    fi
    if [[ -z "$model" && "$profile" == claude-* ]]; then
      model="opus"
    fi
    export SLOPU_AGENT_PROFILE="$profile" SLOPU_AGENT_EFFORT=max CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0
    [[ -z "$model" ]] || export SLOPU_AGENT_MODEL="$model"
    exec "$REPO_ROOT/ops/publish-generate.sh" video
    ;;
  held)
    shopt -s nullglob
    for marker in "$REPO_ROOT"/data/candidates/*.held; do
      run_id="$(basename "$marker" .held)"
      echo "${run_id}  $(git -C "$REPO_ROOT" log -1 --format=%s "press-gen-${run_id}" 2>/dev/null)"
      for draft in "$REPO_ROOT/data/pending-uploads/${run_id}"/review/*-draft.mp4; do echo "  ${draft}"; done
      [[ -f "$REPO_ROOT/data/pending-uploads/${run_id}/review/review.json" ]] \
        && echo "  review: $(jq -r 'if .pass then "pass" else "FAIL: " + (.failed | join(", ")) end' "$REPO_ROOT/data/pending-uploads/${run_id}/review/review.json")"
    done
    exit 0
    ;;
  approve|reject)
    (( $# == 1 )) || { echo "slopu: $command takes a run id" >&2; exit 2; }
    marker="$REPO_ROOT/data/candidates/$1.held"
    [[ -f "$marker" ]] || { echo "slopu: no held candidate $1 (slopu held lists them)" >&2; exit 2; }
    if [[ "$command" == approve ]]; then
      mv "$marker" "${marker%.held}.json"
      echo "released $1; the lander lands it on its next tick"
    else
      git -C "$REPO_ROOT" branch -D "press-gen-$1"
      rm -rf "$REPO_ROOT/data/pending-uploads/$1"
      rm -f "$marker"
      echo "discarded $1"
    fi
    exit 0
    ;;
  land)
    # Mechanical: no model, no agent-run. ops/land.sh takes the publish lock,
    # gates the staged artefact, uploads and pushes.
    exec "$REPO_ROOT/ops/land.sh" "$@"
    ;;
  publish)
    (( $# == 0 )) || { echo "slopu: publish takes no arguments" >&2; exit 2; }
    # Preserve the slash command's Sonnet default on its existing Claude
    # subscription route. Alternative profiles keep their own model default.
    if [[ -z "$model" && "$profile" == "claude-sub" ]]; then
      model="sonnet"
    fi
    prompt="Read skills/publish/SKILL.md and execute its workflow end-to-end, non-interactively. No arguments."
    ;;
  thesis)
    # An optional steering prompt: the thesis's topic, in the register the
    # other academic presets take. Without it the run composes its own topic to
    # fit the drawn fiction; with it, the topic is fixed and the fiction is
    # still drawn. ops/publish-generate.sh says what the wrapper does with it.
    if [[ "${1:-}" == -* ]]; then
      echo "slopu: options go before the command: slopu $1 ... thesis" >&2
      exit 2
    fi
    if (( $# > 0 )); then export SLOPU_STEER="$*"; fi
    # The one publish rung with no timer. It is a generator slot, so the
    # candidate it leaves is landed by the lander (ops/publish-land.sh, on its
    # timer when the split is live; run it by hand otherwise). A stronger
    # model and the highest effort by default, because this run exists to
    # spend a budget on one document; --model overrides.
    if [[ -z "$model" && "$profile" == claude-* ]]; then
      model="opus"
    fi
    export SLOPU_AGENT_PROFILE="$profile" SLOPU_AGENT_EFFORT=max
    [[ -z "$model" ]] || export SLOPU_AGENT_MODEL="$model"
    if [[ -n "$deadline" ]]; then
      SLOPU_DEADLINE="$(date -d "$deadline" '+%H:%M on %A %-d %B %Y (%Z)')" || { echo "slopu: cannot parse deadline: $deadline" >&2; exit 2; }
      export SLOPU_DEADLINE
    fi
    export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0
    # The subscription's session window is shared with the generator slots,
    # and a thesis that starts into a half-spent window dies at the session
    # limit an hour in. Hold slot 1's lock for the run: it waits out slot 1's
    # current run, slot 1's ticks skip until the thesis ends, and the lock dies
    # with the process however it exits. -o keeps the agent's background
    # processes from inheriting it. Slots 2+ are not held.
    #
    # A further thesis slot (--slot N) is started beside the first, which
    # already holds that lock, so it takes none.
    if [[ -n "$slot" ]]; then
      if ! [[ "$slot" =~ ^[0-9]+$ ]] || (( 10#$slot < 2 )); then
        echo "slopu: --slot takes an integer >= 2" >&2
        exit 2
      fi
      exec "$REPO_ROOT/ops/publish-generate.sh" "thesis${slot}"
    fi
    lock="$REPO_ROOT/data/publish-gen-1.lock"
    flock -n "$lock" true || echo "slopu: waiting for slot 1's current run to finish" >&2
    exec flock -o "$lock" "$REPO_ROOT/ops/publish-generate.sh" thesis
    ;;
  *)
    echo "slopu: unknown command: $command" >&2
    usage >&2
    exit 2
    ;;
esac

[[ -z "$model" ]] || agent_args+=(--model "$model")
exec "$AGENT_RUN" "${agent_args[@]}" "$prompt"
